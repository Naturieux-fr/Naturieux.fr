# Hidden files & directories (VCS metadata, IDE/editor and local tool caches).
# The build needs none of them; one generic rule keeps the context lean.
.*

# Build artifacts
bin/
dist/
*.exe
main.exe
server

# Test / coverage output
*.out
coverage.html

# Local databases
*.db
*.db-journal
*.db-wal
*.db-shm

# Docs and reports (not needed in the image)
docs/
*.md
QUALITY_REPORT.md
SECURITY_REPORT.md
